  "failure_modes_and_rca": [
    {
      "failure_mode": "Character Entity Eviction Across Multi-Chapter Spans",
      "mechanism": "In 65,000-token novels, main characters introduced in Chapter 1 might not be mentioned for 15,000 tokens during subplots. FIFO and heavy-hitter heuristics evict the character's definition, causing severe perplexity spikes (+2.33 to +5.30) when the character re-enters.",
      "stratakv_resolution": "Tier-1 pins character root declarations in SLC; Tier-2 maintains episodic anchors, preventing character amnesia."
    },
    {
      "failure_mode": "Thematic Drift in Sliding Windows",
      "mechanism": "Sliding windows discard the entire thematic setup of the book, forcing the model to predict next tokens purely based on immediate local dialogue.",
      "stratakv_resolution": "Golden-ratio dissolution prunes redundant adjectives and filler prose while preserving thematic nouns and global state."
    },
    {
      "failure_mode": "Memory Exhaustion in Full Attention (14.3 GB)",
      "mechanism": "Uncompressed full attention requires 14.3 GB of FP16 memory at 65,536 tokens. On a 48 GB Mac running a 27B model, this triggers memory compression and thermal throttling.",
      "stratakv_resolution": "Fixed 117.4 MB footprint achieves 122.1x compression with only +0.09 perplexity delta."
    }
  ],
